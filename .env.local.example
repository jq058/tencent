# ── Internal Brain — environment configuration ──────────────────
#
# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored and must never be committed.
#
# Only ONE provider key is needed. ADP is preferred.

# ── Tencent ADP (preferred) ─────────────────────────────────────
# Uses a Single Workflow application configured in the ADP console.
# The model is selected inside the ADP workflow, not here.
ADP_APP_KEY=your_adp_app_key_here

# ── CodeBuddy Agent SDK ─────────────────────────────────────────
# CODEBUDDY_API_KEY=your_codebuddy_api_key_here
# CODEBUDDY_MODEL=optional_model_name
# CODEBUDDY_ENDPOINT=optional_custom_endpoint

# ── OpenAI ──────────────────────────────────────────────────────
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o

# ── Anthropic ───────────────────────────────────────────────────
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# ── DeepSeek ────────────────────────────────────────────────────
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_MODEL=deepseek-chat

# ── Google AI / Gemini ───────────────────────────────────────────
# GOOGLE_AI_API_KEY=your_google_ai_api_key_here
# GOOGLE_AI_MODEL=gemini-1.5-flash

# ── Demo operator secret ────────────────────────────────────────
# Required for POST mutations to /api/demo (update, revoke, reset).
# Set this to a strong random value for local development.
DEMO_OPERATOR_SECRET=your_demo_operator_secret_here
